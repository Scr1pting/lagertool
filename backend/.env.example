# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=appdb


# Application Configuration
APP_PORT=8000

# Description Generation Service
DESCRIPTION_GEN_URL=http://localhost:8080
# Where the browser is sent after a successful login
FRONTEND_URL=http://localhost:5173


# Auth is on unless USING_AUTH=false (or -using_auth=false). Set false only for local dev without Keycloak.
USING_AUTH=true

# OIDC / Keycloak (VIS / VSETH) - only needed with auth on
VSETH_CLIENT_ID=
VSETH_CLIENT_SECRET=
OIDC_ISSUER_URL=https://keycloak-fake.vis.ethz.ch/realms/VSETH
OIDC_REDIRECT_URL=http://localhost:8000/auth/eduid/callback
OIDC_POST_LOGOUT_REDIRECT=http://localhost:5173
# Comma-separated client:role pairs from the Keycloak token that grant admin rights | temporary until lagertool gets its own roles
AUTH_ADMIN_ROLES=member-api:admin

# Cookie attributes for sessions / oauth-flow cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=true

# Secrets — base64-encoded, at least 32 bytes after decoding.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
