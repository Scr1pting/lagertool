# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=example
DB_NAME=appdb

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Application Configuration
APP_PORT=8000

# Auth (VSETH Keycloak) - only needed with -using_auth
VSETH_CLIENT_ID=
VSETH_CLIENT_SECRET=
AUTH_REDIRECT_URL=http://localhost:8000/auth/eduid/callback
AUTH_ISSUER_URL=https://keycloak-fake.vis.ethz.ch/realms/VSETH
# Comma-separated client:role pairs from the Keycloak token that grant admin rights | temporary util lagertool gets its own roles
AUTH_ADMIN_ROLES=member-api:admin
